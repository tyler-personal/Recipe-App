{
  "routes": [
    {
      "src": "/apple-touch-icon.png",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate",
        "Pragma": "no-cache"
      },
      "continue": true
    },
    {
      "src": "/favicon.svg",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/",
      "has": [{ "type": "query", "key": "recipe" }],
      "dest": "/api/recipe-preview"
    },
    { "handle": "filesystem" }
  ]
}
